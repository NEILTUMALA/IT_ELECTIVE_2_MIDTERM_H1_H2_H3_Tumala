@model IEnumerable<PosWebApplication.Models.Entities.Product>

@{
    ViewData["Title"] = "Catalog - Pixel Vault Games";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🎮 Pixel Vault Games - Catalog</h2>
        <a asp-controller="Cart" asp-action="Index" class="btn btn-primary">
            🛒 View Cart
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var product in Model)
        {
            bool isOutOfStock = product.StockQuantity <= 0;

            <div class="col">
                <div class="card h-100 @(isOutOfStock ? "bg-light border-danger text-muted" : "border-dark")">
                    <div class="card-body">
                        <h5 class="card-title">@product.Name</h5>
                        <h6 class="card-subtitle mb-2 text-primary fw-bold">$@product.Price.ToString("F2")</h6>

                        <p class="card-text">
                            @if (isOutOfStock)
                            {
                                <span class="badge bg-danger">OUT OF STOCK</span>
                            }
                            else
                            {
                                <span class="badge bg-success">In Stock: @product.StockQuantity</span>
                            }
                        </p>

                        @if (!isOutOfStock)
                        {
                            <form asp-controller="Catalog" asp-action="AddToCart" method="post" class="mt-3">
                                <input type="hidden" name="ProductId" value="@product.Id" />

                                <div class="input-group mb-2">
                                    <span class="input-group-text">Qty</span>
                                    <input type="number" name="Quantity" value="1" min="1" max="@product.StockQuantity" class="form-control" required />
                                </div>

                                <button type="submit" class="btn btn-outline-primary w-100">
                                    ➕ Add to Cart
                                </button>
                            </form>
                        }
                        else
                        {
                            <button class="btn btn-secondary w-100 mt-3" disabled>Unavailable</button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>