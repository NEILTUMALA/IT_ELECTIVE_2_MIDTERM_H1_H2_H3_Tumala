@model PosWebApplication.Models.DTOs.CheckoutFormDTO

@{
    ViewData["Title"] = "Checkout - Pixel Vault Games";
}

<div class="container my-4" style="max-width: 600px;">
    <h2>💳 Store Checkout</h2>
    <p class="text-muted">Enter customer details to complete the purchase.</p>
    <hr />

    <form asp-controller="Checkout" asp-action="ProcessCheckout" method="post">
        <!-- Display overall validation errors[cite: 1] -->
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="CustomerName" class="form-label fw-bold"></label>
            <input asp-for="CustomerName" class="form-control" placeholder="e.g. John Doe" />
            <span asp-validation-for="CustomerName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CustomerEmail" class="form-label fw-bold"></label>
            <input asp-for="CustomerEmail" class="form-control" placeholder="e.g. customer@example.com (Optional)" />
            <span asp-validation-for="CustomerEmail" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary">
                ⬅️ Back to Cart
            </a>
            <button type="submit" class="btn btn-success btn-lg">
                ✅ Confirm & Process Payment
            </button>
        </div>
    </form>
</div>