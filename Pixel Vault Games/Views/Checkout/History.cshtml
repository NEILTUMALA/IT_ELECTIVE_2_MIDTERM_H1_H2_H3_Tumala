@model IEnumerable<PosWebApplication.Models.Entities.Transaction>

    @{
    ViewData["Title"] = "Sales History - Pixel Vault Games";
    }

    <div class="container my-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>📜 Completed Transactions</h2>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-primary">
                🎮 Back to Catalog
            </a>
        </div>

        @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-4">
            <h4>No sales recorded yet!</h4>
            <p>Completed checkout transactions will appear here.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Transaction ID</th>
                        <th>Date & Time</th>
                        <th>Customer Name</th>
                        <th>Grand Total</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sale in Model)
                    {
                    <tr>
                        <td class="fw-bold">#@sale.TransactionId</td>
                        <td>@sale.Date.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@sale.CustomerName</td>
                        <td class="fw-bold text-success">$@sale.TotalAmount.ToString("F2")</td>
                        <td>
                            <a asp-controller="Checkout" asp-action="Details" asp-route-id="@sale.TransactionId" class="btn btn-sm btn-info text-white">
                                🔍 View Receipt
                            </a>
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    </div>
